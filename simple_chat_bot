import os
import sys
from groq import Groq, APIError


TOKEN = os.environ.get("GROQ_API_KEY")
if not TOKEN:
    print("Error: GROQ_API_KEY belum diset.")
    sys.exit(1)

client = Groq(api_key=TOKEN)

# Tanam prompt sistem di sini
conversation_history = [
    {
        "role": "system",
        "content": """Kamu adalah asisten AI yang bernama Jarvis.
        Kamu selalu menjawab dalam bahasa Indonesia.
        Kamu ramah, sopan, dan to the point.
        Jika tidak tahu jawaban, kamu jujur mengatakannya."""
    }
]

print("=" * 50)
print("       Chat dengan Jarvis AI")
print("=" * 50)
print("Ketik 'exit' atau 'quit' untuk keluar")
print("Ketik 'clear' untuk hapus riwayat chat")
print("=" * 50)

while True:
    user_input = input("\nKamu: ").strip()

    if not user_input:
        continue

    if user_input.lower() in ["exit", "quit"]:
        print("Sampai jumpa!")
        break

    if user_input.lower() == "clear":
        # Tetap simpan system prompt saat clear
        conversation_history = [conversation_history[0]]
        print("Riwayat chat dihapus.")
        continue

    conversation_history.append({
        "role": "user",
        "content": user_input
    })

    try:
        response = client.chat.completions.create(
            model="llama-3.1-8b-instant",
            messages=conversation_history 
        ) 

        ai_reply = response.choices[0].message.content 

        conversation_history.append({
            "role": "assistant",
            "content": ai_reply 
        })

        print(f"\nJarvis: {ai_reply}")
    except APIError as e:
        print(f"\nError API: {e.message}")
        # Hapus user message jika API gagal
        conversation_history.pop()
    except Exception as e:
        print(f"\nError: {e}")
        # Hapus user message jika gagal
        conversation_history.pop()
